SECRET_KEY=change-me
# Password for the seeded admin and test customers (synthetic, dev only)
SEED_PASSWORD=change-me-too
# Neo4j dev database (docker compose up -d). The password needs at least 8 characters.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-min-8-chars
# A2 image generation: "claude" (needs ANTHROPIC_API_KEY) or "fake" (offline placeholder pictures)
IMAGE_GENERATOR=claude
# Never commit a real key. .env is listed in .gitignore.
ANTHROPIC_API_KEY=
